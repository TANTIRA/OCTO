@prefix inv: <https://mesta.asset/ontology/investment#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic negative fixtures. Each entity breaches exactly one constraint so a
# shape that stops biting is caught by a named failure instead of a vague one.
# This graph MUST NOT conform; see OntologyValidatorTest.

# 1. fundStatus outside the fund-status @values.
inv:fund-broken-status a inv:Fund ;
    inv:legalName "Broken Status Fund LP" ;
    inv:fundStatus "closed-beta" .

# 2. LEI that does not match ^[A-Z0-9]{20}$.
inv:limited-partner-broken-lei a inv:LimitedPartner ;
    inv:legalName "Broken Lei Partner" ;
    inv:lei "ABC123" .

# 3. confidenceLevel above the 0..1 @range.
inv:extracted-claim-broken-confidence a inv:ExtractedClaim ;
    inv:description "Claim with an out-of-range confidence." ;
    inv:confidenceLevel "1.5"^^xsd:double .

# 4. Ledger event missing the mandatory currencyCode.
inv:ledger-event-broken-currency a inv:LedgerEvent ;
    inv:flowType "expense" ;
    inv:monetaryAmount 125000.00 ;
    inv:occurredAt "2026-02-10T11:00:00Z"^^xsd:dateTime .

# 5. Superseding event without the rationale the supersedes relation requires.
inv:ledger-event-original-ok a inv:LedgerEvent ;
    inv:flowType "contribution" ;
    inv:monetaryAmount 5000000.00 ;
    inv:currencyCode "USD" ;
    inv:occurredAt "2026-01-05T09:00:00Z"^^xsd:dateTime .

inv:ledger-event-broken-supersede a inv:LedgerEvent ;
    inv:flowType "distribution" ;
    inv:monetaryAmount 5000000.00 ;
    inv:currencyCode "USD" ;
    inv:occurredAt "2026-01-06T09:00:00Z"^^xsd:dateTime ;
    inv:supersedes inv:ledger-event-original-ok .

# 6. Screening decision with no recorded rationale.
inv:screening-decision-broken-rationale a inv:ScreeningDecision ;
    inv:screeningResult "pass" ;
    inv:criterionVersion "industrials-v3" .
