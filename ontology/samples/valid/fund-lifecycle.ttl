@prefix inv: <https://mesta.asset/ontology/investment#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic sample graph. Must conform to every shape in
# ontology/mesta-investment-shacl.ttl. No real firm, fund, LP, or company data.

inv:fund-manager-aurora a inv:FundManager ;
    inv:legalName "Aurora Capital Partners Pte Ltd" .

inv:fund-aurora-iii a inv:Fund ;
    inv:legalName "Aurora Industrial Partners III LP" ;
    inv:fundStatus "investing" ;
    inv:currencyCode "USD" ;
    inv:vintageYear 2021 ;
    inv:fundSector inv:sector-industrials ;
    inv:fundDomicile inv:country-sg .

inv:sector-industrials a inv:Sector ;
    inv:sectorName "Industrials" .

inv:country-sg a inv:Country ;
    inv:isoCountryCode "SG" .

inv:limited-partner-nusantara a inv:LimitedPartner ;
    inv:legalName "Nusantara Sovereign Fund" ;
    inv:lei "5493001KJTIIGC8Y1R12" .

inv:operating-company-fn-nyc a inv:OperatingCompany ;
    inv:legalName "FN NYC Manufacturing Inc" ;
    inv:foundedDate "1998-04-02"^^xsd:date ;
    inv:companySector inv:sector-industrials ;
    inv:companyDomicile inv:country-sg .

inv:person-rina a inv:Person ;
    inv:legalName "Rina Hartono" ;
    inv:email "rina.hartono@example.com" ;
    inv:jobTitle "Investment Director" .

# Look-through edge. TypeQL models ownership as a relation owning ownership-pct
# and effective-date; those arrive with relation reification — see TODO(issue-id).
inv:fund-manager-aurora inv:owner inv:operating-company-fn-nyc .

inv:deal-fn-nyc a inv:Deal ;
    inv:displayName "FN NYC" ;
    inv:dealStatus "due-diligence" ;
    inv:dealSource "proprietary" ;
    inv:dealCompany inv:operating-company-fn-nyc .

inv:investment-fn-nyc a inv:Investment ;
    inv:displayName "FN NYC Series B" ;
    inv:investmentStatus "unrealized" .

inv:ledger-event-call-001 a inv:LedgerEvent ;
    inv:flowType "contribution" ;
    inv:monetaryAmount 25000000.00 ;
    inv:currencyCode "USD" ;
    inv:occurredAt "2026-01-15T09:30:00Z"^^xsd:dateTime ;
    inv:cashFlowPosition inv:investment-fn-nyc .

inv:ledger-event-call-001-reversal a inv:LedgerEvent ;
    inv:flowType "recallable-distribution" ;
    inv:monetaryAmount 2500000.00 ;
    inv:currencyCode "USD" ;
    inv:occurredAt "2026-02-01T09:30:00Z"^^xsd:dateTime ;
    inv:cashFlowPosition inv:investment-fn-nyc ;
    inv:supersedes inv:ledger-event-call-001 ;
    inv:rationale "Partial recall of the January capital call after the allocation was revised." .

inv:valuation-event-fn-nyc-2026q1 a inv:ValuationEvent ;
    inv:monetaryAmount 31250000.00 ;
    inv:asOfDate "2026-03-31"^^xsd:date ;
    inv:valuationMethod "comparables" ;
    inv:valuationSubject inv:investment-fn-nyc .

inv:document-fn-nyc-pitch a inv:Document ;
    inv:fileName "fn-nyc-pitch-2026.pdf" ;
    inv:documentType "pitch-deck" ;
    inv:documentSha256 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ;
    inv:documentDeal inv:deal-fn-nyc .

inv:extracted-claim-fn-nyc-revenue a inv:ExtractedClaim ;
    inv:description "FY2025 revenue of USD 84.2m stated on slide 12." ;
    inv:confidenceLevel "0.87"^^xsd:double ;
    inv:claimDocument inv:document-fn-nyc-pitch .

inv:screening-decision-fn-nyc a inv:ScreeningDecision ;
    inv:screeningResult "conditional" ;
    inv:criterionVersion "industrials-v3" ;
    inv:rationale "Revenue threshold met; five-year CAGR evidence missing from the deck." ;
    inv:screeningDeal inv:deal-fn-nyc .
