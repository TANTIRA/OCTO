@prefix inv:  <https://mesta.asset/ontology/investment#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

inv: a owl:Ontology ;
    rdfs:label "Mesta-Asset investment ontology"@en ;
    rdfs:comment "OWL mirror of ontology/mesta-investment.tql (TypeQL 3.0). Classes and properties only; per-class cardinality and value constraints live in mesta-investment-shacl.ttl. OWL/SHACL is the deterministic CI gate; TypeQL remains the instance store per ADR-0003."@en ;
    owl:versionIRI <https://mesta.asset/ontology/investment/0.1.0> .

# ---------------------------------------------------------------------------
# Entity classes
#
# TODO(issue-id): reify the n-ary TypeQL relations that carry attributes
# (commitment, ownership, employment, board-seat, fund-investment,
# cash-flow-attribution, supersedes, extraction-source, source-attribution)
# so their owned attributes become SHACL-checkable. Increment 1 covers
# entity-level constraints only.
# ---------------------------------------------------------------------------

inv:Party a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "Abstract party; anything that can hold a legal identity in the investment graph."@en .

inv:Organization a owl:Class ;
    rdfs:subClassOf inv:Party ;
    rdfs:label "Organization"@en .

inv:FundManager a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    rdfs:label "Fund manager"@en .

inv:LimitedPartner a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    rdfs:label "Limited partner"@en .

inv:OperatingCompany a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    rdfs:label "Operating company"@en .

inv:DataProvider a owl:Class ;
    rdfs:subClassOf inv:Organization ;
    rdfs:label "Data provider"@en .

inv:Person a owl:Class ;
    rdfs:subClassOf inv:Party ;
    rdfs:label "Person"@en .

inv:Sector a owl:Class ;
    rdfs:label "Sector"@en .

inv:Country a owl:Class ;
    rdfs:label "Country"@en .

inv:Fund a owl:Class ;
    rdfs:label "Fund"@en .

inv:Deal a owl:Class ;
    rdfs:label "Deal"@en .

inv:Investment a owl:Class ;
    rdfs:label "Investment"@en .

inv:LedgerEvent a owl:Class ;
    rdfs:label "Ledger event"@en ;
    rdfs:comment "Append-only financial event. Never mutated; corrections are new events linked by inv:supersedes."@en .

inv:ValuationEvent a owl:Class ;
    rdfs:label "Valuation event"@en .

inv:Document a owl:Class ;
    rdfs:label "Document"@en .

inv:ExtractedClaim a owl:Class ;
    rdfs:label "Extracted claim"@en .

inv:ScreeningDecision a owl:Class ;
    rdfs:label "Screening decision"@en .

# ---------------------------------------------------------------------------
# Datatype properties
#
# No rdfs:domain: TypeQL attributes are shared across types and "owned" per
# type. Per-class ownership is enforced by SHACL shapes, not by OWL domains.
# ---------------------------------------------------------------------------

inv:legalName a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:displayName a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:externalId a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:lei a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:description a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:email a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:phone a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:website a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:jobTitle a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:roleTitle a owl:DatatypeProperty ; rdfs:range xsd:string .

inv:isoCountryCode a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:sectorName a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:strategyName a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:currencyCode a owl:DatatypeProperty ; rdfs:range xsd:string .

inv:dealSource a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:dealStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:fundStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:investmentStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:documentType a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:flowType a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:valuationMethod a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:screeningResult a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:confidenceLevel a owl:DatatypeProperty ; rdfs:range xsd:double .

inv:monetaryAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
inv:committedAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
inv:investedAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
inv:ownershipPct a owl:DatatypeProperty ; rdfs:range xsd:decimal .
inv:headcount a owl:DatatypeProperty ; rdfs:range xsd:integer .
inv:vintageYear a owl:DatatypeProperty ; rdfs:range xsd:integer .

inv:foundedDate a owl:DatatypeProperty ; rdfs:range xsd:date .
inv:effectiveDate a owl:DatatypeProperty ; rdfs:range xsd:date .
inv:endDate a owl:DatatypeProperty ; rdfs:range xsd:date .
inv:asOfDate a owl:DatatypeProperty ; rdfs:range xsd:date .
inv:occurredAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
inv:recordedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
inv:documentSha256 a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:fileName a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:criterionVersion a owl:DatatypeProperty ; rdfs:range xsd:string .
inv:rationale a owl:DatatypeProperty ; rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Object properties
#
# Only the links needed to keep increment-1 sample data coherent are declared.
# The remaining TypeQL relations arrive with relation reification (see TODO above).
# ---------------------------------------------------------------------------

inv:owner a owl:ObjectProperty ;
    rdfs:domain inv:Organization ;
    rdfs:range inv:Organization ;
    rdfs:label "owner"@en ;
    rdfs:comment "Look-through ownership edge. TypeQL declares both ownership roles on organization; the mesta-investment.tql comment claims party scoping — see TODO(issue-id)."@en .

inv:fundSector a owl:ObjectProperty ; rdfs:domain inv:Fund ; rdfs:range inv:Sector .
inv:companySector a owl:ObjectProperty ; rdfs:domain inv:OperatingCompany ; rdfs:range inv:Sector .
inv:fundDomicile a owl:ObjectProperty ; rdfs:domain inv:Fund ; rdfs:range inv:Country .
inv:companyDomicile a owl:ObjectProperty ; rdfs:domain inv:OperatingCompany ; rdfs:range inv:Country .
inv:dealCompany a owl:ObjectProperty ; rdfs:domain inv:Deal ; rdfs:range inv:OperatingCompany .
inv:screeningDeal a owl:ObjectProperty ; rdfs:domain inv:ScreeningDecision ; rdfs:range inv:Deal .
inv:documentDeal a owl:ObjectProperty ; rdfs:domain inv:Document ; rdfs:range inv:Deal .
inv:claimDocument a owl:ObjectProperty ; rdfs:domain inv:ExtractedClaim ; rdfs:range inv:Document .
inv:valuationSubject a owl:ObjectProperty ; rdfs:domain inv:ValuationEvent ; rdfs:range inv:Investment .
inv:cashFlowPosition a owl:ObjectProperty ; rdfs:domain inv:LedgerEvent ; rdfs:range inv:Investment .
inv:supersedes a owl:ObjectProperty ;
    rdfs:domain inv:LedgerEvent ;
    rdfs:range inv:LedgerEvent ;
    rdfs:comment "Correction link: the replacement event points at the original. History is preserved."@en .
inv:sourceProvider a owl:ObjectProperty ; rdfs:domain inv:Document ; rdfs:range inv:DataProvider .
