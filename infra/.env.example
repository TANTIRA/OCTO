# OCTO deployment variables — names only, no values.
# Values come from the secret manager / Dokploy project env config.
# Per ADR-0002: no production .env file is the system of record.

# ---- Environment ----
ENVIRONMENT=                  # dev | staging | prod
SPRING_PROFILES_ACTIVE=       # dev | staging | prod
DATA_NETWORK=                 # external network shared with the supabase project

# ---- Images ----
REGISTRY_URL=                 # e.g. ghcr.io/anterodaemon
API_IMAGE_TAG=                # required: commit-sha or semver tag (compose refuses to render without it)
WEB_IMAGE_TAG=                # required: commit-sha or semver tag (compose refuses to render without it)

# ---- PostgreSQL (self-hosted Supabase stack) ----
POSTGRES_HOST=                # db service on the shared data network
POSTGRES_DB=                  # postgres
DB_USER=                      # runtime role — non-superuser, app schemas only
DB_PASSWORD=
DB_MIGRATION_USER=            # separate role used only by Flyway
DB_MIGRATION_PASSWORD=

# ---- Supabase services ----
# The api reads no Supabase URL or key (#340). SUPABASE_SERVICE_KEY stays absent in particular:
# the api must not hold the RLS-bypassing service key. Wire the narrow credential a feature
# actually reads (user-JWT passthrough or scoped key) in the PR that adds the feature.

# ---- Auth ----
AUTH_ISSUER=                  # Supabase Auth issuer
AUTH_JWKS_URL=                # JWKS endpoint for token validation
AUTH_AUDIENCE=                # expected JWT aud; GoTrue default is "authenticated"
AUTH_PUBLIC_URL=              # public auth URL for the web app

# ---- Neo4j graph projection (ADR-0004, #308) ----
# The api's GraphProjector drains octo.graph_outbox into Neo4j. Blank NEO4J_URI = projector off;
# store writes still enqueue and the outbox drains once a graph is configured. Bolt stays private.
# bolt://octo-neo4j-db:7687 on dokploy-network
NEO4J_URI=
# default: neo4j
NEO4J_DATABASE=
# required when NEO4J_URI is set
NEO4J_USER=
NEO4J_PASSWORD=

# ---- Decision model (TypeSafe Jev via OpenRouter) ----
# Passed to the api service. Only the key is required; the other two fall back
# to the defaults in DecisionModelConfig when blank. Leave the key empty if the
# decision-model features are not enabled in this environment.
# Comments sit on their own line: an inline comment becomes part of the value.
OPENROUTER_API_KEY=
# default: typesafe/jev-1.13
DECISION_MODEL=
# default: https://openrouter.ai/api/alpha/decisions
DECISION_MODEL_ENDPOINT=

# ---- Observability ----

# ---- Public URLs (Dokploy domain assignments) ----
API_PUBLIC_URL=
WEB_PUBLIC_URL=

# ---- Helius (read-only Solana onchain ingestion) ----
# API key for the Helius RPC/Wallet clients; env only, never committed or logged.
HELIUS_API_KEY=
# default: https://mainnet.helius-rpc.com
HELIUS_RPC_URL=
# default: https://api.helius.xyz
HELIUS_WALLET_API_URL=
# default: mainnet
HELIUS_NETWORK=
# Shared secret the webhook receiver expects in the Authorization header; unset = endpoint
# rejects every delivery (fail closed). Configure the same value on the Helius webhook.
HELIUS_WEBHOOK_SECRET=

# ---- Alpha Vantage (read-only market data ingestion) ----
# API key for the Alpha Vantage query endpoint; env only, never committed or logged.
# Free keys are evaluation-scale — production use needs a premium plan; see
# docs/alphavantage-fit-assessment.md.
ALPHA_VANTAGE_API_KEY=
# default: https://www.alphavantage.co
ALPHA_VANTAGE_BASE_URL=

# ---- Agents sidecar ----
# Base URL of the OCTO agents sidecar. Unset means no sidecar is deployed;
# agent features are unavailable but the api continues to function.
OCTO_AGENTS_BASE_URL=
# Bearer token for the agents sidecar; required only if OCTO_AGENTS_BASE_URL is set.
OCTO_AGENTS_TOKEN=

# ---- Redis (quota counters) ----
# Hostname of the Redis service holding the rate-limit counters. Unset means no Redis:
# the limiters still enforce, with in-process counters per api instance.
REDIS_HOST=
# default: 6379
REDIS_PORT=

# ---- Platform administration ----
# Comma-separated list of JWT subjects (sub claim) allowed to provision new tenants
# and manage platform-level settings. Unset means no admins; tenant provisioning APIs
# are 403 Forbidden.
OCTO_PLATFORM_ADMINS=
