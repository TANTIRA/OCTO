# OCTO local development variables — names only, no values.
# For deployment, see infra/.env.example; those values come from the secret manager.
# Copy this file to .env for local use. .env is gitignored and never committed.
#
# Comments sit on their own line on purpose: an inline comment becomes part of
# the value when a file is read as an env file.

# ---- Runtime ----
# dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# ---- PostgreSQL ----
# localhost
DB_HOST=localhost
# 5432
DB_PORT=5432
# postgres
DB_NAME=postgres
# runtime role — non-superuser, app schemas only
DB_USER=postgres
DB_PASSWORD=postgres
# separate role used only by Flyway
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=postgres

# ---- Decision model (TypeSafe Jev via OpenRouter) ----
# Read by modules/control-panel. Only the key is required; the other two fall
# back to the defaults in DecisionModelConfig when blank.
# Never commit a real key. A key that was ever committed counts as leaked.
OPENROUTER_API_KEY=
# default: typesafe/jev-1.13
DECISION_MODEL=typesafe/jev-1.13
# default: https://openrouter.ai/api/alpha/decisions
DECISION_MODEL_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# ---- Helius (read-only Solana onchain ingestion) ----
# API key for the Helius RPC/Wallet clients; env only, never committed or logged.
HELIUS_API_KEY=
# default: https://mainnet.helius-rpc.com
HELIUS_RPC_URL=
# default: https://api.helius.xyz
HELIUS_WALLET_API_URL=
# default: mainnet
HELIUS_NETWORK=
# Shared secret the webhook receiver expects in the Authorization header; unset = endpoint
# rejects every delivery (fail closed). Configure the same value on the Helius webhook.
HELIUS_WEBHOOK_SECRET=

# ---- Alpha Vantage (read-only market data ingestion) ----
# API key for the Alpha Vantage query endpoint; env only, never committed or logged.
# Free keys are evaluation-scale — production use needs a premium plan; see
# docs/alphavantage-fit-assessment.md.
ALPHA_VANTAGE_API_KEY=
# default: https://www.alphavantage.co
ALPHA_VANTAGE_BASE_URL=

# ---- Neo4j (local container octo-neo4j-db, matches Dokploy OCTO/neo4j) ----
# bolt://localhost:7687 for the local container; bolt://octo-neo4j-db:7687 on dokploy-network
NEO4J_URI=
# http://localhost:7474 for the local container
NEO4J_HTTP_URL=
# neo4j
NEO4J_DATABASE=
NEO4J_USER=
NEO4J_PASSWORD=

# ---- Arbitrum One (read-only EVM onchain ingestion) ----
# HTTPS JSON-RPC endpoint for Arbitrum One; unset disables the whole EVM slice.
# Provider URLs commonly embed the key in the path — never logged or committed.
ARBITRUM_RPC_URL=
# Optional bearer token for providers that authenticate by header instead of URL.
ARBITRUM_API_KEY=
# Expected chain id; the scan refuses to run against any other network. default: 42161
ARBITRUM_CHAIN_ID=
# First block scanned when staging is empty. default: 0
ARBITRUM_START_BLOCK=
# Max blocks per eth_getLogs call; range errors shrink it further. default: 10000
ARBITRUM_MAX_BLOCK_WINDOW=
# Poll interval and initial delay in ms. defaults: 60000 / 15000
ARBITRUM_POLL_MS=
ARBITRUM_POLL_INITIAL_DELAY_MS=

# ---- Web (Next.js) ----
# Optional Solana RPC endpoint for the wallet-connect provider. Wallet sign-in
# (SIWS) only signs locally — it never talks to this endpoint. default: devnet
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---- Agent sidecar (ADR-0005) ----
# Service-principal JWT the sidecar presents to the api — least privilege,
# workflow tasks and report drafts only. Mint ops-side; never reuse a user JWT.
OCTO_AGENT_TOKEN=
# Shared bearer the api presents when calling the sidecar. no default
OCTO_AGENTS_TOKEN=
# First workflow flag — Investment Screening & DD, tasks-only. default: false
OCTO_AGENTS_SCREENING_DD_ENABLED=false

# ---- Platform admin (tenant provisioning) ----
# Comma-separated JWT subjects allowed to create tenants and manage any tenant's
# members via /api/v1/admin/tenants*. Unset or empty denies everybody.
OCTO_PLATFORM_ADMINS=

# ---- Rate limiting (per-tenant quota) ----
# Redis holding the fixed-window counters for RateLimitFilter. Unset disables the
# limiter entirely — no quota is enforced without the cache tier.
REDIS_HOST=
REDIS_PORT=6379
# Requests/min one tenant may consume before 429. Per-tenant override:
# PUT /api/v1/admin/tenants/{id}/settings  key "rate_limit_per_minute".
OCTO_RATE_LIMIT_PER_MINUTE=120

# ---- Tenant isolation tiers (ADR-0007) ----
# Bridge placements: comma-separated datasource keys, each with an OCTO_DS_<KEY> triple.
# A listed key missing any of URL/USER/PASSWORD fails startup.
# OCTO_TENANT_DATASOURCES=bridge-acme
# OCTO_DS_BRIDGE_ACME_URL=jdbc:postgresql://host:5432/octo_bridge_acme
# OCTO_DS_BRIDGE_ACME_USER=octo_bridge_app
# OCTO_DS_BRIDGE_ACME_PASSWORD=
# OCTO_DS_BRIDGE_ACME_POOL_SIZE=5
