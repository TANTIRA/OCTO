# Mesta-Asset local development variables — names only, no values.
# For deployment, see infra/.env.example; those values come from the secret manager.
# Copy this file to .env for local use. .env is gitignored and never committed.
#
# Comments sit on their own line on purpose: an inline comment becomes part of
# the value when a file is read as an env file.

# ---- Runtime ----
# dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# ---- PostgreSQL ----
# localhost
DB_HOST=localhost
# 5432
DB_PORT=5432
# postgres
DB_NAME=postgres
# runtime role — non-superuser, app schemas only
DB_USER=postgres
DB_PASSWORD=postgres
# separate role used only by Flyway
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=postgres

# ---- Decision model (TypeSafe Jev via OpenRouter) ----
# Read by modules/control-panel. Only the key is required; the other two fall
# back to the defaults in DecisionModelConfig when blank.
# Never commit a real key. A key that was ever committed counts as leaked.
OPENROUTER_API_KEY=sk-or-v1-a886602100087110120082008200820082008200820082008200820082008200
# default: typesafe/jev-1.13
DECISION_MODEL=typesafe/jev-1.13
# default: https://openrouter.ai/api/alpha/decisions
DECISION_MODEL_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# ---- Helius (read-only Solana onchain ingestion) ----
# API key for the Helius RPC/Wallet clients; env only, never committed or logged.
HELIUS_API_KEY=
# default: https://mainnet.helius-rpc.com
HELIUS_RPC_URL=
# default: https://api.helius.xyz
HELIUS_WALLET_API_URL=
# default: mainnet
HELIUS_NETWORK=
# Shared secret the webhook receiver expects in the Authorization header; unset = endpoint
# rejects every delivery (fail closed). Configure the same value on the Helius webhook.
HELIUS_WEBHOOK_SECRET=
